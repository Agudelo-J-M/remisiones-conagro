<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvw_Titulo_Inventario_Bodega"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:text="@string/inventario_bodega"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@color/dark_blue"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/svw_ContenedorTabla_Inventario_Bodega"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvw_Titulo_Inventario_Bodega"
        app:layout_constraintBottom_toTopOf="@id/lly_Botones_Inventario_Bodega"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableLayout
            android:id="@+id/tly_TablaDatos_Inventario_Bodega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- Header populated programmatically to adapt to view mode -->
        </TableLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/lly_Botones_Inventario_Bodega"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_Rechazar_Inventario_Bodega"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Rechazar"
            app:backgroundTint="@color/blue"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btn_Aceptar_Inventario_Bodega"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Aceptar"
            app:backgroundTint="@color/blue"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>