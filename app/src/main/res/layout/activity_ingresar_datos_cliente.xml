<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvw_Titulo_Datos_Cliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Datos de Nuevo Cliente"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp"
            android:background="@color/dark_blue"
            android:textColor="@color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvw_Info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Complete la información del cliente para la oficina:"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvw_Titulo_Datos_Cliente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_NombreFinca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Nombre Finca"
            android:inputType="textCapCharacters"
            android:maxLength="40"
            app:layout_constraintTop_toBottomOf="@id/tvw_Info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_Direccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Dirección"
            android:inputType="textCapSentences"
            android:maxLength="40"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_NombreFinca"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_Ciudad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Ciudad"
            android:inputType="textCapSentences"
            android:maxLength="30"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_Direccion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_NombrePersona"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nombre Cliente"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="40"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_Ciudad"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_Telefono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Teléfono"
            android:inputType="phone"
            android:maxLength="15"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_NombrePersona"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/edt_Nuevo_Email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:maxLength="40"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_Telefono"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_Continuar_Datos_Cliente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Continuar (Firmar)"
            app:backgroundTint="@color/blue"
            android:textColor="@color/white"
            app:layout_constraintTop_toBottomOf="@id/edt_Nuevo_Email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="1.0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>