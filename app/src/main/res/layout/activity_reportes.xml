<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ReportesActivity">

    <TextView
        android:id="@+id/tvw_Titulo_Reportes"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@color/dark_blue"
        android:gravity="center"
        android:text="Reportes de Remisiones"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/lly_Controles_Reportes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvw_Titulo_Reportes">

        <Spinner
            android:id="@+id/spn_TipoBusqueda_Reportes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp" />

        <AutoCompleteTextView
            android:id="@+id/edt_InputBusqueda_Reportes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:hint="Buscar..."
            android:completionThreshold="1" />

        <Button
            android:id="@+id/btn_Buscar_Reportes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/hsv_Tabla_Reportes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/tvw_Mensaje_Reportes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lly_Controles_Reportes">

        <TableLayout
            android:id="@+id/tly_TablaDatos_Reportes"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:stretchColumns="*">

            <TableRow
                android:background="#DDDDDD"
                android:padding="8dp">

                <TextView
                    android:padding="8dp"
                    android:text="Remisión"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Finca"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Producto"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Cant"
                    android:textStyle="bold" />

                <TextView
                    android:padding="8dp"
                    android:text="Fecha"
                    android:textStyle="bold" />
            </TableRow>
        </TableLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvw_Mensaje_Reportes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/blue"
        android:textStyle="italic"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_MostrarTodo_Reportes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btn_MostrarTodo_Reportes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mostrar Todo"
        app:backgroundTint="@color/blue"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>